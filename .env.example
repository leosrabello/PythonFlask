# Copie este arquivo para .env e ajuste os valores.
FLASK_APP=run.py
FLASK_DEBUG=1

# Chave usada pelo Flask (troque por algo aleatorio)
SECRET_KEY=troque-esta-chave

# Banco de dados.
# SQLite (padrao, nao precisa instalar nada):
DATABASE_URL=sqlite:///biblioteca.db
# MySQL (exemplo, se o grupo optar por MySQL):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/biblioteca
